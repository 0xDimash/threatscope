# Copy to .env and adjust. Never commit .env.
# SQLite by default — no database server needed. See docs/adr/0002-sqlite.md.
DATABASE_URL=sqlite+pysqlite:///./data/threatscope.db
# Swap for Postgres later without code changes:
# DATABASE_URL=postgresql+psycopg://threatscope:threatscope@localhost:5432/threatscope
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# Frontend (Vite reads VITE_* from frontend/.env)
VITE_API_BASE=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/events
